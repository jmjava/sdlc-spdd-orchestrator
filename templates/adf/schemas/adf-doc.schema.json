{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jmjava.github.io/sdlc-spdd-orchestrator/schemas/adf-doc.json",
  "title": "Minimal Jira Cloud ADF document",
  "type": "object",
  "required": ["type", "version", "content"],
  "additionalProperties": true,
  "properties": {
    "type": { "const": "doc" },
    "version": { "type": "integer", "const": 1 },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
